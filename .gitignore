# gitignore

# Operating system
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Local database files
*.sqlite
*.sqlite3
*.db

# Data and ML artifacts
backend/ml/data/raw/**
backend/ml/data/interim/**
backend/ml/data/processed/**
backend/ml/model_registry/**
!backend/ml/data/raw/.gitkeep
!backend/ml/data/interim/.gitkeep
!backend/ml/data/processed/.gitkeep
!backend/ml/model_registry/.gitkeep
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.h5
*.safetensors
