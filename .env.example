# TradeSquare environment variables

Copy this file to `.env` for local development. Use placeholder values only.

POSTGRES_DB=tradesquare
POSTGRES_USER=tradesquare
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://tradesquare:change-me-locally@localhost:5432/tradesquare
APP_ENV=development
SECRET_KEY=replace-with-local-secret
